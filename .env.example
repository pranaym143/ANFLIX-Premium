# GEMINI_API_KEY: Optional for AI Studio server-side capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ANILIST_API_URL: Public GraphQL endpoint (Defaults to https://graphql.anilist.co)
VITE_ANILIST_API_URL="https://graphql.anilist.co"

# FUTURE GOOGLE ADSENSE INTEGRATION (Disabled by default):
# Set VITE_ADSENSE_ENABLED="true" and provide your official publisher ID when approved
VITE_ADSENSE_ENABLED="false"
VITE_ADSENSE_CLIENT_ID=""
